#!/bin/sh
# Git pre-push hook: runs scripts/validation/prepush-scan.mjs for every branch or tag being pushed.
# Enable it once per clone (it is not active until you do):
#   git config core.hooksPath scripts/hooks
# Optional, local only: export PRD_PRIVACY_DENYLIST=<path of the private deny-list, outside the repository>
# Git passes the remote name and URL as arguments and one line per ref on standard input:
#   <local ref> <local sha> <remote ref> <remote sha>

remote="$1"
root=$(git rev-parse --show-toplevel) || exit 1

if ! command -v node >/dev/null 2>&1; then
  echo "pre-push: node is not on PATH, so the pre-push scan cannot run; push refused." >&2
  echo "pre-push: put Node 24 on PATH, or run node scripts/validation/prepush-scan.mjs by hand." >&2
  exit 1
fi

# Compare with the remote's main branch when this clone has it, otherwise with origin/main.
base="refs/remotes/$remote/main"
git rev-parse --verify --quiet "$base^{commit}" >/dev/null 2>&1 || base="origin/main"

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "$local_sha" ] || continue
  case "$local_sha" in
    *[!0]*) ;;          # a commit is being pushed
    *) continue ;;      # all zeros: the remote ref is being deleted; nothing to scan
  esac
  echo "pre-push: scanning $local_ref -> $remote_ref"
  node "$root/scripts/validation/prepush-scan.mjs" --base "$base" --head "$local_sha" || status=1
done

if [ "$status" -ne 0 ]; then
  echo "pre-push: refused. Fix the findings above (never commit client data, names or secrets), then push again." >&2
fi
exit "$status"
