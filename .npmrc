# npm settings for the new application's build tooling (CR-0006, D-025). See docs/new-build/toolchain.md.
# Never run a package's install scripts: esbuild and TypeScript find their platform binary without them.
ignore-scripts=true
# Record exact versions, never ranges.
save-exact=true
# No funding banner and no audit request during installs: npm ci then contacts the registry only for the
# tarballs the lockfile names (or nothing at all with --offline and a warm cache). Run "npm audit" on purpose.
fund=false
audit=false
